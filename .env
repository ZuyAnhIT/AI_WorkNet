PORT=8000

# --- GEMINI CONFIG ---
# Key bạn đã cung cấp
GEMINI_API_KEY=
# Lưu ý: Nếu lỗi model, hãy đổi thành gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --- JAVA BACKEND CONFIG ---
BACKEND_BASE_URL=http://localhost:8082
# Dán Token JWT (Bearer Token) của bạn vào đây
JAVA_ACCESS_TOKEN=
# --- OTHER SERVICES ---
PYTHON_SERVICE_URL=http://localhost:8001