PORT=8000

# --- GEMINI CONFIG ---
# Thay vì gemini-1.5-flash, hãy thử dòng này:
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEYS=

# --- CẤU HÌNH CHÍNH ---
LLM_PROVIDER=groq
# --- GROQ CONFIG ---
GROQ_API_KEY=
# Model này mạnh nhất và hỗ trợ Tool Calling tốt nhất trên Groq hiện nay
GROQ_MODEL=llama-3.3-70b-versatile
# --- JAVA BACKEND CONFIG ---
BACKEND_BASE_URL=http://localhost:8082
# --- OTHER SERVICES ---
PYTHON_SERVICE_URL=http://localhost:8001
